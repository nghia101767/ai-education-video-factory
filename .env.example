NODE_ENV=development
APP_URL=https://web.ai-education-video-factory.orb.local
INTERNAL_APP_URL=http://web:3000
MONGODB_URI=mongodb://app_user:change_me@mongodb:27017/ai_education_video_factory?authSource=ai_education_video_factory
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_me_root_password
MONGO_DATABASE=ai_education_video_factory
MONGO_APP_USERNAME=app_user
MONGO_APP_PASSWORD=change_me
STORAGE_ROOT=/app/storage
LOG_LEVEL=info
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
YOUTUBE_CREDENTIAL_KEY=replace-with-a-long-random-key
YOUTUBE_OAUTH_STATE_SECRET=replace-with-a-long-random-secret
AI_LLM_PROVIDER=mock
IMAGE_PROVIDER=mock
# AI_IMAGE_PROVIDER is retained as a compatibility alias when IMAGE_PROVIDER is unset.
AI_IMAGE_PROVIDER=mock
TTS_PROVIDER=vieneu
VIENEU_TTS_URL=http://tts:8000
VIENEU_CONCURRENCY=1
VIENEU_VOICE=default
VIENEU_TIMEOUT_MS=900000
VIENEU_OFFLINE=0
MOCK_AI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_SCRIPT_MODEL=gpt-5.6-luna
OPENAI_STORYBOARD_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-1
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
AI_TIMEOUT_MS=60000
AI_PRICING_JSON=
DAILY_AI_BUDGET=0
MONTHLY_AI_BUDGET=0
AI_RETRY_LIMIT=2
AI_RETRY_BASE_MS=1000
YOUTUBE_PROVIDER=mock
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://web.ai-education-video-factory.orb.local/api/youtube/oauth/callback
